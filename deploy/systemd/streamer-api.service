[Unit]
Description=StreamKit API (FastAPI backend)
After=network.target

[Service]
Type=simple
User=streamkit
Group=streamkit
WorkingDirectory=/root/livechat-app/api
Environment=PYTHONPATH=/root/livechat-app/api
Environment=STREAMKIT_LOG_LEVEL=INFO
Environment=STREAMKIT_CONFIG_DIR=/var/lib/streamkit
EnvironmentFile=/etc/streamkit/env
ExecStart=/var/lib/streamkit/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
LimitNOFILE=65536
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
