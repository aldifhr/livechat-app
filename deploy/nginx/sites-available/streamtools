server {
    listen 80;
    server_name streamtools.aldifhr.my.id;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name streamtools.aldifhr.my.id;

    ssl_certificate     /etc/letsencrypt/live/streamtools.aldifhr.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/streamtools.aldifhr.my.id/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Overlay sockets and the handle resolver belong to the loopback bridge.
    # They are open by design: an OBS browser source cannot present a session.
    location /ws/ {
        proxy_pass http://127.0.0.1:8004;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/room-connect-by-username {
        proxy_pass http://127.0.0.1:8004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Overlay pages are meant to be framed by OBS and TikTok LIVE Studio.
    # nginx.conf adds SAMEORIGIN globally; a more specific add_header replaces
    # that inherited value, so framing is allowed only on these paths.
    location ^~ /overlay/ {
        proxy_pass http://127.0.0.1:5184;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Frame-Options ALLOWALL always;
    }

    # Everything else is the Next app: it serves the overlays and the landing
    # page openly, and its own proxy gate sends the console to /login. Keeping
    # the gate there avoids a second session check in nginx that can disagree
    # with the app's.
    location / {
        proxy_pass http://127.0.0.1:5184;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
