[Unit]
Description=StreamKit Web Frontend (Next.js)
After=network-online.target tiktok-bridge.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/livechat-app/web
Environment=PATH=/root/livechat-app/web/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=/etc/streamkit/env
# change-password writes the new bcrypt hash here (systemd EnvironmentFile,
# not a Next .env). ProtectSystem=full makes /etc read-only, so allow writes
# to this one directory for the atomic temp-file + rename in envFile.ts.
Environment=STREAMKIT_ENV_FILE=/etc/streamkit/env
ReadWritePaths=/etc/streamkit
# Dashboard password hash & session secret come from the env file above — never here.
Environment=NEXT_PUBLIC_CONVEX_URL=https://kit-backend.aldifhr.my.id
Environment=BRIDGE_URL=http://127.0.0.1:8004
Environment=BACKEND_ORIGIN=https://kit-backend.aldifhr.my.id
ExecStart=/root/livechat-app/web/node_modules/.bin/next start --port 5184 --hostname 127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=65536
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
