*.log

# The bridge was a build artifact once; it is gone. The app reads a backend now.
sidecar/

# The repo root is a container now. Each part builds from its own directory and
# the root has no manifest of its own. node_modules/ and dist/ are written with
# no leading path so they are ignored wherever a part puts them.
node_modules/
dist/
.next/
out/
app/src-tauri/target/
app/src-tauri/gen/

# Credentials are typed into the app at runtime and read from Tauri's config
# directory, never from here. Ignored anyway so a stray file cannot be committed
# by accident.
.env
.env.*

# Python, from the StreamKit backend that lives in this repo now.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/__pycache__/
*.pyc

# Runtime state — local room records and usernames, not source.
backend/config/rooms.json
backend/config/overlays.json

# The nginx basic-auth hash for the deployed dashboard. It lives only on the
# server, at /etc/nginx/streamtools.htpasswd, and is never source. Committing a
# copy put the bcrypt hash of the admin password in a public repository — a hash
# is offline-crackable, so it is a credential, not a config file. Kept ignored
# here (and named exactly) so a stray copy at the repo root cannot be committed
# again.
streamtools

# ...except the vhost of the same name under deploy/, which is source. The rule
# above is deliberately a bare filename so it catches a stray copy anywhere; the
# exception has to name the one path that is meant to be tracked, and it carries
# no credential — the vhost only says who to ask, never what the password is.
!deploy/nginx/sites-available/streamtools

# The dashboard's own password hash, for a checkout running it locally. The same
# reasoning as the hash above, and the same breadth: `web/.data/htpasswd` is where
# a local `STREAMKIT_HTPASSWD` points, and `htpasswd` is left as a bare filename
# so a copy at the repo root cannot be committed either.
.data/
htpasswd

.hermes/

# TypeScript incremental build cache — rewritten by every web build, so it is
# noise in a diff, not source.
web/tsconfig.tsbuildinfo
