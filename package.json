{
  "name": "livechat-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:collapse && npm run test:errors && npm run test:ui && npm run test:stats && npm run test:llm && npm run test:backend && npm run test:sound && npm run test:log && npm run test:sidecar",
    "test:collapse": "node sidecar/test-collapse.mjs",
    "test:errors": "node sidecar/test-errors.mjs",
    "test:ui": "node sidecar/test/test-ui.mjs",
    "test:stats": "node sidecar/test-stats.mjs",
    "test:llm": "node sidecar/test-llm.mjs",
    "test:backend": "node sidecar/test-backend.mjs",
    "test:sound": "node sidecar/test-sound.mjs",
    "test:e2e": "node sidecar/test/e2e.mjs",
    "test:log": "node sidecar/test-log.mjs",
    "test:sidecar": "node sidecar/test-sidecar.mjs",
    "test:orphan": "node sidecar/test-orphan.mjs sidecar/livechat-bridge.exe",
    "bridge:install": "npm --prefix sidecar install",
    "build:bridge": "bun build --compile sidecar/index.mjs --outfile sidecar/livechat-bridge.exe && node -e \"require('fs').copyFileSync('sidecar/livechat-bridge.exe','src-tauri/resources/livechat-bridge.exe')\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
