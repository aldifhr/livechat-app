[Unit]
Description=StreamKit Python backend (Postgres + TikTok watcher + overlay sockets)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/livechat-app/api_py
EnvironmentFile=/etc/streamkit/python.env
ExecStart=/root/livechat-app/api_py/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8004 --log-level info
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/root/livechat-app/api_py

[Install]
WantedBy=multi-user.target
