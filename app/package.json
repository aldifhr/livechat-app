{
  "name": "livechat-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:collapse && npm run test:ui && npm run test:stats && npm run test:layout && npm run test:overlay && npm run test:backend && npm run test:sound && npm run test:templates && npm run test:mentions && npm run test:wire",
    "test:collapse": "node test/test-collapse.mjs",
    "test:ui": "node test/test-ui.mjs",
    "test:stats": "node test/test-stats.mjs",
    "test:layout": "node test/test-layout.mjs",
    "test:overlay": "node test/test-overlay.mjs && node test/test-overlay-page.mjs && node test/test-overlay-sync.mjs",
    "test:backend": "node test/test-backend.mjs",
    "test:sound": "node test/test-sound.mjs",
    "test:templates": "node test/test-templates.mjs",
    "test:mentions": "node test/test-mentions.mjs && npm run test:wire && npm run test:voice",
    "test:wire": "node test/test-wire.mjs",
    "test:voice": "node test/test-voice.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "apexcharts": "^8.3.0",
    "canvas-confetti": "^1.9.4",
    "motion": "^14.2.0",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
